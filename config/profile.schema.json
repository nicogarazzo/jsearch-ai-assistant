{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nicogarazzo/jsearch-ai-assistant/config/profile.schema.json",
  "title": "JSearch Profile",
  "description": "Single source of truth for a JSearch user. The setup assistant writes this file; scripts/import_profile.py expands it into config/profile.yaml and config/search-criteria.yaml.",
  "type": "object",
  "required": ["identity", "professional_summary", "work_history", "skills", "search_criteria"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "default": "1.0" },

    "identity": {
      "type": "object",
      "required": ["full_name", "email", "location"],
      "additionalProperties": false,
      "properties": {
        "full_name": { "type": "string" },
        "birth_date": { "type": ["string", "null"], "description": "ISO 8601 (YYYY-MM-DD). Used only to compute age when an application form asks for it. Optional.", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "email": { "type": "string" },
        "phone": { "type": ["string", "null"] },
        "location": { "type": "string" },
        "linkedin": { "type": ["string", "null"] },
        "website": { "type": ["string", "null"] },
        "github": { "type": ["string", "null"] },
        "languages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["language", "level"],
            "additionalProperties": false,
            "properties": {
              "language": { "type": "string" },
              "level": { "type": "string", "description": "native, C2, C1, B2, B1, A2, A1 or plain words." }
            }
          }
        }
      }
    },

    "current_role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "company": { "type": "string" },
        "industry": { "type": ["string", "null"] },
        "years_in_role": { "type": ["number", "null"] }
      }
    },

    "total_experience_years": { "type": ["number", "null"] },

    "professional_summary": {
      "type": "string",
      "description": "3 to 6 sentences. Facts and numbers, no adjectives without evidence."
    },

    "work_history": {
      "type": "array",
      "minItems": 1,
      "description": "Most recent first.",
      "items": {
        "type": "object",
        "required": ["company", "title", "period"],
        "additionalProperties": false,
        "properties": {
          "company": { "type": "string" },
          "title": { "type": "string" },
          "period": { "type": "string", "description": "e.g. \"2022 - Present\" or \"2019 - 2024\"." },
          "location": { "type": ["string", "null"] },
          "highlights": { "type": "array", "items": { "type": "string" }, "description": "Achievements with numbers where possible." },
          "skills_used": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["degree", "institution"],
        "additionalProperties": false,
        "properties": {
          "degree": { "type": "string" },
          "institution": { "type": "string" },
          "period": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] }
        }
      }
    },

    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "technical": { "type": "array", "items": { "type": "string" } },
        "domain": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } },
        "soft": { "type": "array", "items": { "type": "string" } }
      }
    },

    "certifications": { "type": "array", "items": { "type": "string" } },

    "notable_achievements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "context"],
        "additionalProperties": false,
        "properties": {
          "metric": { "type": "string", "description": "The number itself, e.g. \"$4M+ USD revenue\"." },
          "context": { "type": "string", "description": "Where it happened. Keeps figures attached to the right employer." }
        }
      }
    },

    "work_preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remote_ok": { "type": "boolean" },
        "hybrid_ok": { "type": "boolean" },
        "onsite_ok": { "type": "boolean" },
        "willing_to_relocate": { "type": "boolean" },
        "timezone_flexibility": { "type": ["string", "null"] },
        "notice_period": { "type": ["string", "null"] },
        "work_authorization": { "type": ["string", "null"], "description": "e.g. \"EU citizen\", \"needs US sponsorship\"." }
      }
    },

    "salary_expectations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] },
        "currency": { "type": "string", "default": "USD" },
        "period": { "type": "string", "enum": ["year", "month", "hour"], "default": "year" },
        "notes": { "type": ["string", "null"] }
      }
    },

    "narrative_rules": {
      "type": "object",
      "description": "Guardrails the assistant must respect when writing a CV or cover letter.",
      "additionalProperties": false,
      "properties": {
        "lead_with_company": { "type": ["string", "null"], "description": "Company name that must open every narrative, usually the current employer." },
        "de_emphasize_companies": { "type": "array", "items": { "type": "string" }, "description": "Mention only as brief historical context, never as the closing point." },
        "fact_guards": {
          "type": "array",
          "description": "Numbers that must stay attached to one employer and never be swapped.",
          "items": {
            "type": "object",
            "required": ["claim", "owner"],
            "additionalProperties": false,
            "properties": {
              "claim": { "type": "string" },
              "owner": { "type": "string" }
            }
          }
        },
        "style_bans": { "type": "array", "items": { "type": "string" }, "description": "Things never to write, e.g. \"em dashes\", \"the word synergy\"." }
      }
    },

    "search_criteria": {
      "type": "object",
      "required": ["target_roles"],
      "additionalProperties": false,
      "properties": {
        "target_roles": {
          "type": "object",
          "required": ["titles"],
          "additionalProperties": false,
          "properties": {
            "titles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "seniority": { "type": "array", "items": { "type": "string", "enum": ["intern", "junior", "mid", "senior", "lead", "manager", "director", "vp", "c-level"] } }
          }
        },
        "target_industries": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preferred": { "type": "array", "items": { "type": "string" } },
            "acceptable": { "type": "array", "items": { "type": "string" } },
            "avoid": { "type": "array", "items": { "type": "string" } }
          }
        },
        "location_preferences": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preferred_locations": { "type": "array", "items": { "type": "string" } },
            "acceptable_regions": { "type": "array", "items": { "type": "string" } },
            "excluded_locations": { "type": "array", "items": { "type": "string" } }
          }
        },
        "company_preferences": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min_employees": { "type": ["integer", "null"] },
                "max_employees": { "type": ["integer", "null"] }
              }
            },
            "stage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "preferred": { "type": "array", "items": { "type": "string" } },
                "acceptable": { "type": "array", "items": { "type": "string" } }
              }
            },
            "culture_signals": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "positive": { "type": "array", "items": { "type": "string" } },
                "negative": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        "deal_breakers": { "type": "array", "items": { "type": "string" }, "description": "Any match caps the fit score at 30." },
        "bonus_signals": { "type": "array", "items": { "type": "string" } },
        "minimum_score": { "type": "integer", "minimum": 0, "maximum": 100, "default": 50 },
        "auto_prepare_threshold": { "type": "integer", "minimum": 0, "maximum": 100, "default": 85 },
        "materials_language": {
          "type": "string",
          "description": "Fallback language for CV and cover letter when the posting language is ambiguous. ISO code or plain name.",
          "default": "English"
        }
      }
    }
  }
}
